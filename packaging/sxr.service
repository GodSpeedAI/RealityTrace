[Unit]
Description=SXR optional daemon (commit queue service, spec section 16)
Documentation=man:sxr(1)

[Service]
Type=notify
ExecStart=%h/.local/bin/sxr daemon --socket %t/sxr.sock
Restart=on-failure
RestartSec=2
# %t is $XDG_RUNTIME_DIR; sockets must be world-writable so any enrolled
# repo's verifier can submit (socket mode is handled by the daemon itself).

[Install]
WantedBy=default.target
