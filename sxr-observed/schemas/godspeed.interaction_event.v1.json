{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cep.dev/schemas/extensions/godspeed.interaction_event.v1.json",
  "title": "GodSpeed interaction event extension v1",
  "description": "The object carried at extensions[\"godspeed.interaction_event\"] on an execution_trace envelope. One consequential interaction observed by an emitter. It is observation, not settlement (CEP-0008 \u00a79.5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "world_ref",
    "semantic_ref",
    "declaration_key",
    "actor",
    "operation",
    "resource",
    "context",
    "correlation",
    "authority",
    "outcome",
    "source",
    "executor_provenance",
    "kind"
  ],
  "properties": {
    "world_ref": {
      "type": "string",
      "description": "Semantic-world revision of the addressed element (world:<name>@sha256:<64 hex>).",
      "pattern": "^world:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*@sha256:[0-9a-f]{64}$"
    },
    "semantic_ref": {
      "type": "string",
      "description": "Declared element addressed, namespace::name.",
      "pattern": "^[A-Za-z0-9_.-]+::[A-Za-z0-9_.-]+$"
    },
    "declaration_key": {
      "type": "string",
      "description": "concept:<uuidv5 of namespace::name>. Emitted for convenience; the receiver recomputes and never trusts it.",
      "pattern": "^concept:[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal",
        "role"
      ],
      "properties": {
        "principal": {
          "type": "string",
          "minLength": 1,
          "description": "Authenticated principal."
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "description": "SOP role."
        }
      }
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "description": "Declared or observed operation."
    },
    "resource": {
      "type": "string",
      "minLength": 1,
      "description": "Resource acted on."
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "plan_item_id"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "plan_item_id": {
          "type": "string",
          "minLength": 1
        },
        "episode_ref": {
          "type": "string",
          "description": "episode:<case_id>:<plan_item_id>:<n>@sha256:<64 hex>. Required when kind is evaluated.",
          "pattern": "^episode:[^:@\\s]+:[^:@\\s]+:[0-9]+@sha256:[0-9a-f]{64}$"
        },
        "assignment_id": {
          "type": "string",
          "description": "assign:<caseId>:<stepId>:<n>:<k>. Present when the work was delegated.",
          "pattern": "^assign:[^:\\s]+:[^:\\s]+:[0-9]+:[0-9]+$"
        }
      }
    },
    "correlation": {
      "type": "object",
      "description": "Structured; never parsed from a string.",
      "additionalProperties": false,
      "required": [
        "case_id"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "assignment_id": {
          "type": "string",
          "pattern": "^assign:[^:\\s]+:[^:\\s]+:[0-9]+:[0-9]+$"
        },
        "episode_ref": {
          "type": "string",
          "pattern": "^episode:[^:@\\s]+:[^:@\\s]+:[0-9]+@sha256:[0-9a-f]{64}$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "causation_id": {
      "type": "string",
      "minLength": 1,
      "description": "Record id of the cause in the owning system. Present when caused."
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "description": "A SEA-Forge decision id, or the literal not_required, or the literal unknown. Verified against SEA-Forge at ingest."
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "denied",
            "interrupted",
            "unknown"
          ],
          "description": "Observed, never inferred."
        },
        "effect_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "settlement_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Settlement events only."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "record_id",
        "sequence",
        "recorded_at"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1,
          "description": "Pointer to the untouched source record."
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "description": "Owning system's sequence; the ordering field."
        },
        "recorded_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "description": "Emitter clock; informational only, never orders."
        }
      }
    },
    "executor_provenance": {
      "enum": [
        "program",
        "live",
        "injected_fault"
      ]
    },
    "kind": {
      "enum": [
        "evaluated",
        "exploratory"
      ]
    },
    "emitter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signature"
      ],
      "properties": {
        "signature": {
          "type": "object",
          "description": "Workload-identity signature over the canonical extension (RFC 8785, CEP-0008 \u00a716.5) with emitter.signature removed. Required from WP-33; absent before.",
          "additionalProperties": false,
          "required": [
            "key_id",
            "alg",
            "sig"
          ],
          "properties": {
            "key_id": {
              "type": "string",
              "minLength": 1
            },
            "alg": {
              "type": "string",
              "minLength": 1
            },
            "sig": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "expectation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(question|threshold):.+$"
      },
      "description": "RealityTrace question and threshold ids the event bears on (E section 5). Required when kind is evaluated; may be empty. Entries must be unique: JSON Schema uniqueItems is not supported by CEP's own validator (DEBT-IE-01), so uniqueness is checked by consumers and by the contract test (IE_EXPECTATION_REFS_DUPLICATE)."
    }
  },
  "anyOf": [
    {
      "description": "exploratory events need no frozen reference",
      "properties": {
        "kind": {
          "const": "exploratory"
        }
      }
    },
    {
      "description": "evaluated events carry the frozen reference and the expectation",
      "properties": {
        "kind": {
          "const": "evaluated"
        },
        "context": {
          "required": [
            "episode_ref"
          ]
        }
      },
      "required": [
        "expectation_refs"
      ]
    }
  ]
}
