{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sxr.dev/contracts/residual.v1.json",
  "title": "residual (v1)",
  "description": "One difference between the declared model and the observed representation, as written by `observed compare` (event residual.computed). Five classes; not_evaluable and below_minimum_support are bases within insufficient, never classes. Episode and structural residuals are distinguished by `comparison` and never mixed in one list. A residual without a basis, or a confirmed, contradicted, observed_undeclared or declared_unobserved one without occurrences and evidence, is refused (NT-45).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "residual_id",
    "class",
    "basis",
    "comparison",
    "keys",
    "occurrence_ids",
    "evidence_refs",
    "rule",
    "support_count",
    "profile_id",
    "question",
    "snapshot",
    "world_ref"
  ],
  "properties": {
    "contract": { "const": "residual.v1" },
    "residual_id": { "type": "string", "pattern": "^residual:[^\\s]+$" },
    "class": { "enum": ["confirmed", "contradicted", "observed_undeclared", "declared_unobserved", "insufficient"] },
    "basis": {
      "enum": [
        "policy_true",
        "structural_satisfied",
        "policy_false",
        "structural_violated",
        "structural_undeclared",
        "trigger_observed_record_absent",
        "policy_unknown",
        "not_evaluable",
        "below_minimum_support",
        "evidence_source_silent",
        "executor_only_evidence"
      ]
    },
    "comparison": { "enum": ["episode", "structural"] },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?:concept:[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|undeclared:[0-9a-f]{64})$"
      },
      "description": "The declaration keys, or undeclared keys, the difference is about; ascending."
    },
    "occurrence_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[^:\\s]+:[^\\s]+$" },
      "description": "Occurrences behind the result (for declared_unobserved, the trigger occurrences); distinct, ascending."
    },
    "evidence_refs": { "type": "array", "items": { "type": "string", "pattern": "^evidence:[^\\s]+$" } },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "enum": ["policy_evaluable", "structural", "ordering", "frequency", "absence", "timing"], "description": "A comparison-profile kind." },
        "ref": { "type": "string", "minLength": 1, "description": "The policy name or declared relation the rule is." }
      }
    },
    "support_count": { "type": "integer", "minimum": 0, "description": "Supporting occurrences counted against the profile's minimum k." },
    "profile_id": { "type": "string", "pattern": "^profile:[^\\s]+$" },
    "question": { "type": "string", "pattern": "^question:[^\\s]+$" },
    "snapshot": { "type": "string", "minLength": 1, "description": "The declared snapshot id the comparison ran against." },
    "world_ref": { "type": "string", "pattern": "^world:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*@sha256:[0-9a-f]{64}$", "description": "World stamp: the classification belongs to this world and is never retargeted (NT-07)." }
  },
  "allOf": [
    { "if": { "properties": { "class": { "const": "confirmed" } }, "required": ["class"] }, "then": { "properties": { "basis": { "enum": ["policy_true", "structural_satisfied"] } } } },
    { "if": { "properties": { "class": { "const": "contradicted" } }, "required": ["class"] }, "then": { "properties": { "basis": { "enum": ["policy_false", "structural_violated"] } } } },
    { "if": { "properties": { "class": { "const": "observed_undeclared" } }, "required": ["class"] }, "then": { "properties": { "basis": { "const": "structural_undeclared" } } } },
    { "if": { "properties": { "class": { "const": "declared_unobserved" } }, "required": ["class"] }, "then": { "properties": { "basis": { "const": "trigger_observed_record_absent" } } } },
    {
      "if": { "properties": { "class": { "const": "insufficient" } }, "required": ["class"] },
      "then": { "properties": { "basis": { "enum": ["policy_unknown", "not_evaluable", "below_minimum_support", "evidence_source_silent", "executor_only_evidence"] } } },
      "else": {
        "properties": {
          "occurrence_ids": { "minItems": 1 },
          "evidence_refs": { "minItems": 1 }
        }
      }
    }
  ]
}
