{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "plugins": [
    {
      "type": "cargo-workspace",
      "updateAllPackages": true
    }
  ],
  "pull-request-title-pattern": "chore: release RealityTrace ${version}",
  "packages": {
    "sxr-core": {
      "release-type": "rust"
    },
    "sxr-ledger": {
      "release-type": "rust"
    },
    "sxr-git": {
      "release-type": "rust"
    },
    "sxr-df": {
      "release-type": "rust"
    },
    "sxr-verify": {
      "release-type": "rust"
    },
    "sxr-cli": {
      "release-type": "rust",
      "package-name": "realitytrace",
      "component": "realitytrace"
    }
  }
}
